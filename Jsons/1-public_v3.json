{
  "version": "1.0",
  "themeOverrides": {
    "colors": {
      "artcharm": [
        "#fceeee",
        "#f6dada",
        "#f0c5c5",
        "#eab0b0",
        "#e49c9c",
        "#de8787",
        "#d87373",
        "#c76565",
        "#9e6060",
        "#7d4c4c"
      ]
    },
    "primaryColor": "artcharm",
    "primaryShade": { "light": 8, "dark": 8 },
    "other": { "forceColorScheme": "light" },

    "scale": 0.9,

    "fontSizes": {
      "xs":  "0.7rem",
      "sm":  "0.8rem",
      "md":  "0.95rem",
      "lg":  "1.1rem",
      "xl":  "1.25rem"
    },

    "spacing": {
      "xs": "0.5rem",
      "sm": "0.65rem",
      "md": "0.9rem",
      "lg": "1.1rem",
      "xl": "1.75rem"
    },

    "components": {
      "AppBuilderAppShellTemplatePage": {
        "defaultProps": {
          "headerHeight": {
            "base": "3em",
            "md":   "3.5em",
            "lg":   "4em"
          },
          "navbarWidth": {
            "md": 260,
            "lg": 300,
            "xl": 340
          }
        }
      },

      "AppBuilderTextWidgetComponent": {
        "defaultProps": {
          "styles": {
            "root": {
              "textAlign": "center"
            }
          }
        }
      },

      "Button": {
        "defaultProps": {
          "variant": "filled",
          "radius": "8px",
          "size": "sm",
          "fw": "300"
        },
        "styles": {
          "root": {
            "display": "block",
            "marginLeft": "0px",
            "marginRight": "0px"
          }
        }
      },

      "Card": {
        "styles": {
          "root": {
            "borderRadius": "10%",
            "overflow": "hidden"
          }
        }
      },

      "Image": {
        "styles": {
          "root": {
            "transform": "scale(1)",
            "transformOrigin": "center center"
          }
        }
      },

      "SelectGridComponent": {
        "defaultProps": {
          "gridProps": { "cols": 4, "spacing": "xs" },
          "showLabel": false,
          "grow": false
        },
        "styles": {
          "root": {
            "maxWidth": "600px",
            "marginLeft": "auto",
            "marginRight": "auto"
          }
        }
      },

      "ViewportBranding": {
        "defaultProps": {
          "light": { "logo": "https://cdn.artcharm.md/imagini/logo.svg" },
          "dark":  { "logo": "https://cdn.artcharm.md/imagini/logo.svg" }
        }
      },

      "ViewportIcons": {
        "defaultProps": {
          "enableImportExportButtons": false
        }
      }
    }
  }
}
